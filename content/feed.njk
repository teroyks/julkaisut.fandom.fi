---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
{%- set base = metadata.url + "/" -%}
{%- set entries = collections.publicationsByAdded -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ metadata.language }}">
  <title>{{ metadata.title }}</title>
  <subtitle>{{ metadata.description }}</subtitle>
  <link href="{{ metadata.url }}/feed.xml" rel="self" />
  <link href="{{ base }}" />
  <updated>{{ (entries[0].data.added or entries[0].date) | dateToRfc3339 }}</updated>
  <id>{{ base }}</id>
  <author>
    <name>{{ metadata.feed.author }}</name>
  </author>
  {#- `published` is when the article first appeared anywhere, `updated` when it
      appeared here; readers sort on the latter, so historical articles still
      surface as new additions. #}
  {%- for post in entries %}
  {%- set absolutePostUrl %}{{ post.url | htmlBaseUrl(base) }}{% endset %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ absolutePostUrl }}" />
    <published>{{ post.date | dateToRfc3339 }}</published>
    <updated>{{ (post.data.added or post.date) | dateToRfc3339 }}</updated>
    <id>{{ absolutePostUrl }}</id>
    {%- if post.data.author %}
    <author>
      <name>{{ post.data.author }}</name>
    </author>
    {%- endif %}
    {%- if post.data.summary %}
    <summary>{{ post.data.summary }}</summary>
    {%- endif %}
    <content type="html">{{ post.templateContent | renderTransforms(post.data.page, base) }}</content>
  </entry>
  {%- endfor %}
</feed>
