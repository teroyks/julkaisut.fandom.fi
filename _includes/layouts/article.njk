---
layout: layouts/base.njk
---
<article{% if not eleventyExcludeFromCollections %} data-pagefind-body{% endif %} data-pagefind-filter="vuosi:{{ page.date.getUTCFullYear() }}">
  <header>
    <h1>{{ title }}</h1>
    <p class="meta">
      {% if author %}<span class="author" data-pagefind-meta="author">{{ author }}</span> ·{% endif %}
      <time datetime="{{ page.date | isoDate }}" data-pagefind-meta="date">{{ page.date | formatDate }}</time>
    </p>
  </header>
  {{ content | safe }}
</article>
