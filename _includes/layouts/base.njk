<!doctype html>
<html lang="{{ lang or metadata.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title and title != metadata.title %}{{ title }} – {% endif %}{{ metadata.title }}</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <header class="site-header">
      <a href="/">{{ metadata.title }}</a>
    </header>
    <main>
      {{ content | safe }}
    </main>
  </body>
</html>
